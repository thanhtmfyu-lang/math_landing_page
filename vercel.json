{
  "framework": "vite",
  "regions": [
    "sin1"
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/hsa-xep-hang",
      "destination": "/api/xep-hang?muc=hsa"
    },
    {
      "source": "/api/xep-hang-cua-em",
      "destination": "/api/xep-hang?muc=cua-em"
    },
    {
      "source": "/api/bang-tin-anh",
      "destination": "/api/bang-tin?muc=anh"
    },
    {
      "source": "/goc-hoc-tap",
      "destination": "/index.html"
    },
    {
      "source": "/goc-hoc-tap/",
      "destination": "/index.html"
    },
    {
      "source": "/bang-diem",
      "destination": "/index.html"
    },
    {
      "source": "/bang-diem/",
      "destination": "/index.html"
    },
    {
      "source": "/__preview/:path*",
      "destination": "/api/exam?muc=preview-disabled"
    },
    {
      "source": "/bai-hoc/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/khoa-hoc",
      "destination": "/index.html"
    },
    {
      "source": "/khoa-hoc/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/thi-thu",
      "destination": "/index.html"
    },
    {
      "source": "/thi-thu/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/thi-thu-hsa",
      "destination": "/index.html"
    },
    {
      "source": "/kiem-tra-dau-vao",
      "destination": "/index.html"
    },
    {
      "source": "/ky-khao-sat",
      "destination": "/index.html"
    },
    {
      "source": "/phu-huynh",
      "destination": "/index.html"
    },
    {
      "source": "/phong-thi-thu",
      "destination": "/index.html"
    },
    {
      "source": "/api/phong-thi",
      "destination": "/api/exam?muc=phong-thi"
    },
    {
      "source": "/de-giua-ky-1",
      "destination": "/index.html"
    },
    {
      "source": "/so-tay",
      "destination": "/index.html"
    },
    {
      "source": "/san-choi",
      "destination": "/index.html"
    },
    {
      "source": "/san-choi/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/huong-dan",
      "destination": "/index.html"
    },
    {
      "source": "/chinh-sach-bao-mat",
      "destination": "/index.html"
    },
    {
      "source": "/hoc-online",
      "destination": "/index.html"
    },
    {
      "source": "/tai-lieu",
      "destination": "/index.html"
    },
    {
      "source": "/tai-lieu/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/quan-tri/de-thi",
      "destination": "/index.html"
    },
    {
      "source": "/btvn",
      "destination": "/index.html"
    },
    {
      "source": "/btvn/tai-lieu",
      "destination": "/index.html"
    },
    {
      "source": "/quan-tri/btvn",
      "destination": "/index.html"
    },
    {
      "source": "/luyen-tap",
      "destination": "/index.html"
    },
    {
      "source": "/btvn/:class/:lesson",
      "destination": "/index.html"
    },
    {
      "source": "/xep-hang",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/exam-assets/:file([0-9a-f]{64}\\.pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/btvn/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/quan-tri/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/bang-tin.ts": {
      "includeFiles": "server/bang-tin/**"
    },
    "api/kiem-tra-dau-vao.ts": {
      "includeFiles": "server/dau-vao/ngan-hang.bin"
    },
    "api/exam.ts": {
      "includeFiles": "server/phong-thi/kho-de.bin"
    }
  },
  "git": {
    "deploymentEnabled": {
      "codex/web-v13-*": false
    }
  }
}

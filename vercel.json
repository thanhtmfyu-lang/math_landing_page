{
  "framework": "vite",
  "regions": [
    "sin1"
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/goc-hoc-tap",
      "destination": "/index.html"
    },
    {
      "source": "/goc-hoc-tap/",
      "destination": "/index.html"
    },
    {
      "source": "/bang-diem",
      "destination": "/index.html"
    },
    {
      "source": "/bang-diem/",
      "destination": "/index.html"
    },
    {
      "source": "/__preview/:path*",
      "destination": "/api/preview-disabled"
    },
    {
      "source": "/bai-hoc/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/khoa-hoc",
      "destination": "/index.html"
    },
    {
      "source": "/khoa-hoc/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/thi-thu",
      "destination": "/index.html"
    },
    {
      "source": "/thi-thu/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/so-tay",
      "destination": "/index.html"
    },
    {
      "source": "/san-choi",
      "destination": "/index.html"
    },
    {
      "source": "/san-choi/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/huong-dan",
      "destination": "/index.html"
    },
    {
      "source": "/tai-lieu",
      "destination": "/index.html"
    },
    {
      "source": "/tai-lieu/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/quan-tri/de-thi",
      "destination": "/index.html"
    },
    {
      "source": "/btvn",
      "destination": "/index.html"
    },
    {
      "source": "/quan-tri/btvn",
      "destination": "/index.html"
    },
    {
      "source": "/luyen-tap",
      "destination": "/index.html"
    },
    {
      "source": "/btvn/:class/:lesson",
      "destination": "/index.html"
    },
    {
      "source": "/xep-hang",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/exam-assets/:file([0-9a-f]{64}\\.pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/btvn/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/quan-tri/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}

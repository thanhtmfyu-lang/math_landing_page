import assert from 'node:assert/strict';
import {QA_INTAKE,assertQaIntakeFiles,assertQaIntakeFreshLane,assertQaIntakeSession,lessonDashboardRequest,qaIntakePayload,qaIntakeRequested,scopeQaIntakeDashboard} from '../src/native/lesson-upload/qa-intake';
import {clearPending,loadPending,savePending} from '../src/native/lesson-upload/pending-request-store';
import type {LessonSession,UploadDashboard} from '../src/native/lesson-upload/model';

let checks=0;const check=(name:string,fn:()=>void)=>{fn();checks++;};
const session:LessonSession={class_id:QA_INTAKE.classId,class_name:QA_INTAKE.classLabel,lesson_date:QA_INTAKE.lessonDate,teacher_key:QA_INTAKE.teacherKey,start_time:'00:10:00',end_time:'00:11:00',class_ids:[QA_INTAKE.classId],class_dates:{[QA_INTAKE.classId]:QA_INTAKE.lessonDate}};
const staff={user_id:'manager-fake',display_name:'QL giả',short_name:'qa',role:'ql' as const,teacher_key:null};
const upload={id:'qa-upload',class_ids:[QA_INTAKE.classId],lesson_date:QA_INTAKE.lessonDate,teacher_key:QA_INTAKE.teacherKey,title:'QA',task_scope:'Toàn bộ đề',version:1,created_at:'2026-11-18T00:00:00Z',steps:[]};
const raw={staff,assessment_protocol:110,sessions:[session,{...session,class_id:'real-class',class_name:'Lớp thật',class_ids:['real-class']},{...session,lesson_date:'2026-11-16'}],uploads:[upload,{...upload,id:'real-upload',class_ids:['real-class']}],teachers:[staff,{...staff,teacher_key:QA_INTAKE.teacherKey}],classes:[{id:QA_INTAKE.classId},{id:'real-class'}],week_start:'2026-11-16',week_end:'2026-11-22'};
check('query opt-in is explicit; it never changes ordinary dashboard flags',()=>{for(const q of ['','?qa=0','?qa=true','?qa=1&qa=1','?qa=1&qa=0'])assert.equal(qaIntakeRequested(q),false);assert.equal(qaIntakeRequested('?qa=1'),true);assert.deepEqual(lessonDashboardRequest(),{action:'dashboard'});assert.deepEqual(lessonDashboardRequest(true),{action:'dashboard',is_test:true,from:'2026-11-17',to:'2026-11-17'});});
check('server-confirmed manager only; protocol or teacher roles cannot unlock QA',()=>{for(const role of ['gv','none'])assert.throws(()=>scopeQaIntakeDashboard({...raw,staff:{...staff,role}} as UploadDashboard));assert.throws(()=>scopeQaIntakeDashboard({...raw,assessment_protocol:109}));});
check('QA projection contains only pinned class/date/teacher and leaves caller intact',()=>{const frozen=JSON.stringify(raw),scoped=scopeQaIntakeDashboard(raw);assert.equal(scoped.sessions.length,1);assert.equal(scoped.uploads.length,1);assert.deepEqual((scoped as typeof raw).classes,[{id:QA_INTAKE.classId}]);assert.equal(scoped.teachers.length,1);assert.equal(JSON.stringify(raw),frozen);assert.equal(scoped.sessions[0].lesson_date,'2026-11-17');});
check('missing session stays empty; old manual16 is never selected',()=>{assert.equal(scopeQaIntakeDashboard({...raw,sessions:raw.sessions.slice(1)}).sessions.length,0);});
check('fresh server lane catches a second tab before any file upload',()=>{assertQaIntakeFreshLane({...raw,uploads:[]},session,'homework');assert.throws(()=>assertQaIntakeFreshLane(raw,session,'homework'));assert.throws(()=>assertQaIntakeFreshLane({...raw,sessions:[]},session,'exam'));assertQaIntakeFreshLane(raw,session,'exam');});
check('grouped class/date or changed session cannot slip through scope',()=>{for(const patch of [{class_ids:[QA_INTAKE.classId,'real-class']},{class_dates:{[QA_INTAKE.classId]:'2026-11-16'}},{teacher_key:'other'},{lesson_date:'2026-11-16'},{start_time:'00:09'}])assert.throws(()=>assertQaIntakeSession({...session,...patch}));assert.throws(()=>scopeQaIntakeDashboard({...raw,uploads:[{...upload,class_ids:[QA_INTAKE.classId,'real-class']}]}));});
const payload={client_request_id:'stable-uuid',class_ids:[QA_INTAKE.classId],lesson_date:QA_INTAKE.lessonDate,teacher_key:QA_INTAKE.teacherKey,on_behalf_of:QA_INTAKE.teacherKey,title:'QA',work_kind:'homework'};
check('create pins is_test for both business kinds while retaining stable identity',()=>{for(const work_kind of ['homework','exam']){const p={...payload,work_kind};assert.deepEqual(qaIntakePayload(p),{...p,is_test:true});assert.equal('is_test'in p,false);}assert.equal(qaIntakePayload({...payload,is_test:false}).is_test,true);});
check('mixed/real/old scope and unconfirmed storage receipt cannot reach create',()=>{for(const patch of [{class_ids:['real-class']},{class_ids:[QA_INTAKE.classId,'real-class']},{lesson_date:'2026-11-16'},{teacher_key:'other'},{on_behalf_of:null},{__qa_asset_state:'unconfirmed'}])assert.throws(()=>qaIntakePayload({...payload,...patch}));});
check('QA pending cannot read/clear production or legacy pending and owner remains isolated',()=>{const values=new Map<string,string>(),store={getItem:(k:string)=>values.get(k)??null,setItem:(k:string,v:string)=>{values.set(k,v);},removeItem:(k:string)=>{values.delete(k);}};savePending(store,'owner-a',payload);assert.equal(loadPending(store,'owner-a',QA_INTAKE.pendingScope),null);savePending(store,'owner-a',{...payload,is_test:true,__qa_asset_state:'unconfirmed'},QA_INTAKE.pendingScope);assert.equal(loadPending(store,'owner-b',QA_INTAKE.pendingScope),null);clearPending(store,'owner-a',QA_INTAKE.pendingScope);assert.deepEqual(loadPending(store,'owner-a'),payload);assert.equal(loadPending(store,'owner-a',QA_INTAKE.pendingScope),null);values.set('mtm-lesson-pending-v1',JSON.stringify({owner:'owner-a',payload}));assert.equal(loadPending(store,'owner-a',QA_INTAKE.pendingScope),null);});
for(const [mode,bytes] of [['homework',81877],['exam',82567]] as const){await assert.rejects(()=>assertQaIntakeFiles(mode,{homework:[],answer:[]}));checks++;await assert.rejects(()=>assertQaIntakeFiles(mode,{homework:[new File([new Uint8Array(bytes)],'same-size-wrong-source.pdf',{type:'application/pdf'})],answer:[new File(['bad'],'bad.pdf',{type:'application/pdf'})]}),/SHA/);checks++;}
console.log(`${checks} QA intake checks passed: normal dashboard unchanged; explicit manager scope; is_test both kinds; no cross-scope pending; wrong file bytes rejected; no live/network/provider calls.`);

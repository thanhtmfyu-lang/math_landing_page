import {pathToFileURL} from 'node:url';
﻿import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {join} from 'node:path';
import {readFileSync} from 'node:fs';
import {createRankApi} from '../api/xep-hang';
import {pipelineFixture} from './btvn-pipeline-fixture';
import {HomeworkService} from '../server/btvn/service';
import {MemoryHomeworkRepository} from '../server/btvn/repository';
import {SupabaseHomeworkRepository} from '../server/btvn/supabase-repository';
import {validatePracticeExam} from '../src/native/exams/data';
import {concealMonthlySolutions} from '../server/btvn/monthly-policy';
const root=process.env.MTM_ROOT!,require=createRequire(join(root,'package.json'));
const {buildSync}=require('esbuild'),React=require('react'),{renderToStaticMarkup}=require('react-dom/server');
function load(file:string){const code=buildSync({entryPoints:[join(root,file)],bundle:true,write:false,platform:'node',format:'cjs',jsx:'automatic',packages:'external',loader:{'.css':'empty'},logLevel:'silent'}).outputFiles[0].text;const mod={exports:{} as any};new Function('require','module','exports',code)((id:string)=>id.endsWith('.css')?{}:require(id),mod,mod.exports);return mod.exports;}
const {RankContent,rankEmpty}=load('src/native/homework/HomeLeaderboard.tsx');
const render=(props:any)=>renderToStaticMarkup(React.createElement(RankContent,props));
const row={rank:1,fullName:'Học sinh GIẢ đầy đủ',className:'2K9 9+',score:8.5,submitted:2,total:3};
assert.ok(render({rows:[row],status:'ready'}).includes(row.fullName));assert.ok(render({rows:[row],status:'ready',own:true}).includes(row.fullName));assert.ok(render({rows:[row],status:'ready'}).includes('mtm-rank-top'));assert.ok(render({rows:[],status:'ready'}).includes(rankEmpty));assert.ok(render({rows:[],status:'error'}).includes('role="alert"'));assert.ok(render({rows:[],status:'loading'}).includes('Đang tải'));
let calls=0;const env={MTM_RANK_ENABLED:'1',SUPABASE_URL:'https://fake.invalid',SUPABASE_SERVICE_ROLE_KEY:'FAKE-SERVICE-KEY'};
const api=createRankApi(()=>env,async(url,init)=>{calls++;assert.ok(String(url).endsWith('/rpc/mtm_btvn_leaderboard_class'));assert.equal(JSON.parse(String(init?.body)).p_class,null);assert.ok(!('cookie' in (init?.headers??{})));return new Response(JSON.stringify([{...row,studentId:'MUST-NOT-LEAK',phone:'MUST-NOT-LEAK'}]));});
async function request(handler:any,query:any={khoi:'2K9',loai:'btvn-tuan'},method='GET'){const headers:any={};let status=0,body:any;await handler({query,method,headers:{cookie:'DO-NOT-FORWARD'}},{setHeader:(k:string,v:string)=>headers[k]=v,status:(n:number)=>{status=n;return {json:(v:any)=>body=v};}});return {status,headers,body};}
let response=await request(api);assert.equal(response.status,200);assert.equal(response.headers['Cache-Control'],'no-store');assert.ok(!JSON.stringify(response.body).includes('MUST-NOT-LEAK'));assert.ok(!response.headers['Set-Cookie']);
assert.equal((await request(api,{khoi:['2K9'],loai:'btvn-tuan'})).status,400);assert.equal((await request(api,undefined,'POST')).status,405);assert.equal(calls,1);
assert.equal((await request(createRankApi(()=>({}),async()=>{throw Error('must not fetch');}))).body.enabled,false);
response=await request(createRankApi(()=>env,async()=>new Response('{}',{status:500})));assert.equal(response.status,503);assert.equal(response.headers['Cache-Control'],'no-store');
const fixture=pipelineFixture(),exam=fixture.exam;
exam.questions[0].solution='LỜI GIẢI BÍ MẬT';
const concealed=concealMonthlySolutions(exam);assert.ok(!JSON.stringify(concealed).includes('LỜI GIẢI BÍ MẬT'));assert.ok(concealed.questions.every(q=>!('answer' in q)&&!('acceptedAnswers' in q)));assert.equal(concealed.responseMode,'questions-only');assert.equal(validatePracticeExam(concealed).valid,false,'Đề không có khóa chỉ được dùng ở luồng BTVN, không được nhập vào bộ chấm đầy đủ');assert.equal(exam.questions[0].solution,'LỜI GIẢI BÍ MẬT');
let now=Date.parse('2026-10-30T17:00:00+07:00');const opensAt=now+60000,closesAt=now+180000;
const material={...fixture.material,kind:'kiem-tra-thang' as const,opensAt,closesAt,handoutUrl:'https://fake.invalid/SECRET-HANDOUT'};
const student={studentCode:'FAKE-CODE',fullName:'Học sinh GIẢ',phone:'0900000000',className:material.classNames[0]};
const memory=new MemoryHomeworkRepository([student]);
const service=new HomeworkService(memory,exam,0,'fake',material.lessonCode,()=>now,[material]);const token=service.login({studentCode:student.studentCode},'fake');
assert.throws(()=>service.start(token),/chưa mở/);now=opensAt;let state=service.start(token);assert.equal(state.maxAttempts,1);
now+=1000;state=service.save(token,state.draft!.attemptId,{'mc-1':'D'});now=closesAt;
state=service.submit(token,state.draft!.attemptId,{'mc-1':'A'});assert.equal(state.receipts[0].timedOut,true);assert.equal(state.receipts[0].score,3);assert.throws(()=>service.start(token));
let work:any={student:{...student},drafts:[],receipts:[]};
const durable=new SupabaseHomeworkRepository({async rpc(name,args){if(name==='mtm_btvn_read')return {data:{revision:0,exam,material,lessons:[material],work},error:null};if(name==='mtm_btvn_commit'){work={...work,drafts:args.p_drafts,receipts:args.p_receipts};return {data:{ok:true},error:null};}throw Error(name);}},async()=>({}),()=>now);
now=opensAt-1;state=await durable.call('fake','state');assert.equal(state.exam,null);assert.equal(state.canStart,false);
now=opensAt;state=await durable.call('fake','start');assert.equal(state.maxAttempts,1);assert.equal(state.solutionsAvailable,false);assert.ok(!JSON.stringify(state).includes('LỜI GIẢI BÍ MẬT'));assert.ok(!JSON.stringify(state).includes('SECRET-HANDOUT'));
now+=1000;state=await durable.call('fake','submit',material.lessonCode,state.draft!.attemptId,{'mc-1':'D'});assert.equal(state.receipts[0].score,null);assert.equal(work.receipts[0].score,3);assert.ok(!JSON.stringify(state).includes('LỜI GIẢI BÍ MẬT'));
now=closesAt;state=await durable.call('fake','state');assert.equal(state.solutionsAvailable,true);assert.ok(JSON.stringify(state).includes('LỜI GIẢI BÍ MẬT'));
const {default:Overview}=load('src/native/homework/HomeworkOverview.tsx');
const html=renderToStaticMarkup(React.createElement(Overview,{state:{...state,solutionsAvailable:false},busy:false,onStart(){}}));assert.ok(!html.includes('Xem lời giải'));assert.ok(html.includes('Chỉ 1 lượt'));
const cli=await import(pathToFileURL(join(root,'scripts/sync-btvn-monthly.mjs')).href);
assert.equal(cli.monthlyPayload({'2K9 9+':[['Họ và tên','SĐT','Tháng (mm/yyyy)','Điểm'],['GIẢ','+84900000000','10/2026','8,5']]}).rows[0].score,8.5);
assert.throws(()=>cli.monthlyPayload({'2K9 9+':[['Họ và tên','SĐT','Tháng (mm/yyyy)','Điểm'],['GIẢ','0900000000','10/2026','']]}));
const publisher=await import(pathToFileURL(join(root,'scripts/publish-btvn-lesson.mjs')).href);
assert.equal((await publisher.publishLesson({...fixture,kind:'kiem-tra-thang',opensAt:new Date(opensAt).toISOString(),closesAt:new Date(closesAt).toISOString()})).mode,'dry-run');
await assert.rejects(publisher.validateLesson({...fixture,kind:'kiem-tra-thang'}));
assert.ok(!readFileSync(join(root,'src/migration/Experience.tsx'),'utf8').includes('import HomeLeaderboard')); // The replaced hero must not force rank CSS into every route.
assert.ok(readFileSync(join(root,'src/migration/Home.tsx'),'utf8').includes('<RankArena compact/><R106Hero/>'));
console.log('Đạt đợt 15: SSR dữ liệu/rỗng/lỗi; API mặc định tắt, cache, whitelist, không cookie; thi web một lượt, giờ mở/đóng, chấm server, khóa lời giải; CLI Sheet và publish dry-run.');

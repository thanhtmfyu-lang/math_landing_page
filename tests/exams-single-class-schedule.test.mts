import assert from 'node:assert/strict';
import {existsSync,readFileSync} from 'node:fs';
import {join} from 'node:path';
import {classSlots,loadSchedule,parseScheduleCsv,SCHEDULE_SNAPSHOT} from '../server/schedule/lich-lop';
import {loadLich} from '../server/dau-vao/lich-lop';
import {loadClassRules,opensAt,plannedDueAt,rulesFromSchedule} from '../server/btvn/class-rules';
import {classOpeningTimes} from '../server/btvn/class-schedule';
const root=process.env.MTM_ROOT!;
assert.equal(existsSync(join(root,'server/btvn/class-schedule.json')),false);
const policies=JSON.parse(readFileSync(join(root,'server/btvn/class-rules.json'),'utf8'));
assert.ok(Object.values(policies.classes).every((r:any)=>!('sessions' in r)));
assert.equal(classSlots(SCHEDULE_SNAPSHOT,'2K10 9+').some(s=>s.weekday===5),false);
assert.equal(classSlots(SCHEDULE_SNAPSHOT,'2K10 9+',true).some(s=>s.weekday===5),true);
assert.equal(plannedDueAt('2K10 9+','2026-10-20',5,rulesFromSchedule(SCHEDULE_SNAPSHOT)),'2026-10-27T19:00:00+07:00');
assert.equal(plannedDueAt('2K10 9+','2026-10-25',5,rulesFromSchedule(SCHEDULE_SNAPSHOT)),'2026-10-30T19:00:00+07:00');
const csv='Lớp,Thứ,Bắt đầu,Kết thúc\n'+[2,3,4,5,6].map(d=>`2K9 XPS 9+,T${d},18:15,20:15`).join('\n');
let calls=0;const transport=async()=>{calls++;return new Response(csv);};
const env={MTM_LICH_LOP_CSV:'https://docs.google.com/spreadsheets/d/v13-schedule-fixture/export?format=csv'};
const rules=await loadClassRules(env,transport,1000);
const admission=await loadLich(env,transport,2000);
assert.equal(calls,1,'BTVN and admission must share one cache');
assert.equal(admission[0].bat,'18:15');
assert.equal(opensAt('2K9 9+','2026-10-19',rules),'2026-10-19T20:15:00+07:00');
assert.equal(classOpeningTimes({classNames:['2K9 9+'],date:'2026-10-19'},rules)['2K9 9+'],'2026-10-19T20:15:00+07:00');
assert.throws(()=>classOpeningTimes({classNames:['2K15'],date:'2026-10-19'},rules,true),/CLASS_SCHEDULE_UNAVAILABLE/);
const stale=await loadSchedule(env,async()=>{throw Error('offline');},700000);
assert.equal(stale.source,'Lich_lop-cache');
assert.equal(stale.rows[0].bat,'18:15');
const blocked=await loadSchedule({MTM_LICH_LOP_CSV:'https://docs.google.com.evil.invalid/data'},async()=>{throw Error('must not call');});
assert.equal(blocked.source,'snapshot');
assert.deepEqual(parseScheduleCsv('Lớp,Thứ,Bắt đầu,Kết thúc\n2K9,T2,20:00,19:00'),[]);
const bundle=readFileSync(join(root,'supabase/functions/mtm-btvn-publish/handler.generated.js'),'utf8');
for(const exam of JSON.parse(readFileSync(join(root,'src/native/exams/catalog.json'),'utf8')))assert.ok(!bundle.includes(exam.id),'Generated publisher must not copy private catalog fixtures');
console.log('One schedule provider/cache/snapshot; attendance alternatives remain policy; missing live classes cannot publish early.');

import test from 'node:test';
import assert from 'node:assert/strict';
import {approveRelease,hashJson,type PinnedSource} from '../server/btvn/documents/release-gate.ts';
import {bridgePublicationPlan} from '../server/btvn/documents/plan-bridge.ts';
import {createDocumentHomeworkHandler} from '../server/btvn/documents/document-handler.ts';
async function fixture(){
 const question={id:'q1',sourceRef:'I.1',kind:'mc' as const,prompt:'Synthetic protocol fixture only',choices:['a','b','c','d']as [string,string,string,string]},contentHash=await hashJson(question);
 const inventory=[{id:'q1',sourceRef:'I.1',kind:'mc'as const,contentHash},{id:'q2',sourceRef:'I.2',kind:'manual'as const,contentHash:'2'.repeat(64)}];
 const source={lessonKey:'synthetic-gate',sourceVersion:'a'.repeat(64),scopeHash:'b'.repeat(64),inventoryHash:await hashJson(inventory),hsSha256:'c'.repeat(64),gvSha256:'d'.repeat(64),classDates:{QA:'2026-10-19'}};
 const item={id:'q1',contentHash,examVersionHash:'e'.repeat(64),receiptHash:'f'.repeat(64),question};
 const pin:PinnedSource={source,sourceCorrect:true,inventory,questionsPdf:{path:`exam-assets/${source.hsSha256}.pdf`,sha256:source.hsSha256,bytes:100},answersPdf:{path:`exam-assets/${source.gvSha256}.pdf`,sha256:source.gvSha256,bytes:101},questionOnlyReceiptHash:'3'.repeat(64),teacherKeyReceiptHash:'4'.repeat(64),teacherPdfKeyComplete:false,teacherKeyCoveredSourceRefs:['I.1'],keyAvailability:'partial',reviews:[{id:'q1',sourceVersion:source.sourceVersion,scopeHash:source.scopeHash,inventoryHash:source.inventoryHash,contentHash,examVersionHash:item.examVersionHash,receiptHash:item.receiptHash}],classOpensAt:{QA:'2026-10-19T17:30:00+07:00'},classDueAt:{QA:'2026-10-21T17:30:00+07:00'}};
 const plan:any={contract:'MTM-BTVN-RESILIENT-20261019-v1',mode:'partial',assignment_id:'qa-assignment',source_id:'qa-source',class_id:'qa-class',source_version:source.sourceVersion,scope_hash:source.scopeHash,open_at:pin.classOpensAt.QA,due_at:pin.classDueAt.QA,questions:[question],manual_questions:[],inventory:{source_refs:['I.1','I.2']},student_pdf:{sha256:source.hsSha256},teacher_answer_pdf:{sha256:source.gvSha256},teacher_key_complete:false,teacher_key_coverage_refs:['I.1'],teacher_key_pending_refs:['I.2']};
 plan.exam_version_hash=await hashJson(plan);plan.idempotency_key=await hashJson([plan.assignment_id,plan.exam_version_hash]);
 const registry={assignmentId:plan.assignment_id,sourceId:plan.source_id,classId:plan.class_id,className:'QA',planHash:plan.exam_version_hash,pin,reviewed:{q1:{sourceQuestionHash:await hashJson(question),item}}};
 return{pin,plan,registry,...await bridgePublicationPlan(plan,registry)};
}
test('Partial key preserves full inventory, missing key pending, official grading pending',async()=>{const f=await fixture();assert.equal(f.approved.sourceCount,2);assert.equal(f.approved.acceptedCount,1);assert.equal(f.approved.pendingCount,1);assert.equal(f.manifest.pending[0].reasonCode,'ANSWER_MISSING');assert.equal(f.approved.officialGrading,'pending');assert.deepEqual(f.approved.teacherKeyCoverage,{complete:false,coveredSourceRefs:['I.1'],missingSourceRefs:['I.2']});});
test('Accepted question cannot use an unrelated teacher key even with raw review binding',async()=>{const f=await fixture();f.pin.teacherKeyCoveredSourceRefs=['I.2'];await assert.rejects(()=>approveRelease(f.manifest,f.pin),/ACCEPTED_TEACHER_KEY_COVERAGE_REQUIRED/);});
test('All keys missing blocks the whole release',async()=>{const f=await fixture();f.pin.teacherKeyCoveredSourceRefs=[];f.pin.keyAvailability='none';await assert.rejects(()=>approveRelease(f.manifest,f.pin),/SOURCE_OR_ALL_KEYS_INVALID/);});
test('Complete boolean cannot conceal missing coverage',async()=>{const f=await fixture();f.pin.teacherPdfKeyComplete=true;await assert.rejects(()=>approveRelease(f.manifest,f.pin),/TEACHER_KEY_COVERAGE_INCONSISTENT/);});
test('Teacher PDF stays private until own submit receipt on the same version',async()=>{const f=await fixture(),releaseId='11111111-1111-4111-8111-111111111111',attemptId='22222222-2222-4222-8222-222222222222',subjectId='33333333-3333-4333-8333-333333333333',signs:string[]=[];
 const release={...f.approved,releaseId,assets:[f.pin.questionsPdf,f.pin.answersPdf].map(pdf=>({...pdf,storagePath:`btvn/${f.pin.source.lessonKey}/${f.pin.source.sourceVersion}/${pdf.path}`}))};let submitted=false;
 const handler=createDocumentHomeworkHandler({authenticate:async()=>({subjectId,className:'QA'}),rpc:async action=>action==='get_release'?release:{attemptId,releaseId,manifestHash:release.manifestHash,subjectId,revision:0,startedAt:'2026-10-19T11:00:00Z',submittedAt:submitted?'2026-10-19T11:01:00Z':null,answers:{},note:'',attachmentIds:[],receipt:submitted?{receiptId:'44444444-4444-4444-8444-444444444444',attemptId,submittedAt:'2026-10-19T11:01:00Z',late:false,gradingPending:true}:null},upload:async()=>{},sign:async path=>{signs.push(path);return'https://storage.example.test/signed';}},()=>Date.parse('2026-10-19T11:02:00Z'));
 const request=()=>new Request('https://example.test/api/btvn-documents',{method:'POST',headers:{Origin:'https://example.test'},body:JSON.stringify({action:'state',releaseId})});
 let response=await handler(request()),value=await response.json();assert.equal(response.status,200);assert.equal(value.answersPdf,null);assert.equal(signs.length,1);assert.deepEqual(value.teacherKeyCoverage.missingSourceRefs,['I.2']);submitted=true;signs.length=0;response=await handler(request());value=await response.json();assert.equal(response.status,200);assert.equal(value.answersPdf,'https://storage.example.test/signed');assert.equal(signs.length,2);
});

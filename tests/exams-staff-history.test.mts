import assert from 'node:assert/strict';
import {HISTORY_NO_DATA,cleanHistoryQuery,defaultHistoryQuery,historyAttendance,historyAttendanceSource,historyDate,historyDateTime,historyEnrollment,historyRowKey,historyScore,historyScoreBasis,historyStudentName,historyToday,historyWorkLabel,historyWorkStatus,validateHistoryPage,validateHistoryQuery,type StaffHistoryPage,type StaffHistoryQuery,type StaffHistoryRow} from '../src/native/lesson-upload/staff-history';
const query:StaffHistoryQuery={mode:'session',from_date:'2026-10-14',to_date:'2026-11-13',page:1,page_size:20};
assert.equal(validateHistoryQuery(query,'2026-11-13'),null,'31 inclusive days is valid');
assert.ok(validateHistoryQuery({...query,from_date:'2026-10-13'},'2026-11-13'),'32 days must be split into requests');
assert.ok(validateHistoryQuery({...query,to_date:'2026-11-14'},'2026-11-13'),'future end dates are not history');
assert.ok(validateHistoryQuery({...query,from_date:'2026-11-14'},'2026-11-13'),'reversed date range');
for(const bad of ['2026-02-29','2026-02-31','2026-13-01','bad'])assert.ok(validateHistoryQuery({...query,from_date:bad},'2026-11-13'));
assert.equal(validateHistoryQuery({...query,from_date:'2028-02-01',to_date:'2028-03-02'},'2028-03-02'),null,'leap February range');
for(const patch of [{page:0},{page:1.5},{page_size:0},{page_size:101},{name:'a'.repeat(101)}])assert.ok(validateHistoryQuery({...query,...patch},'2026-11-13'));
assert.equal(validateHistoryQuery({...query,mode:'assignment'},'2026-11-13'),null,'assignment history has the same bounded filters');
assert.equal(historyToday(new Date('2026-11-12T18:00:00Z')),'2026-11-13','Vietnam day independent of UTC date');
const defaults=defaultHistoryQuery('2026-11-13');assert.equal(defaults.from_date,'2026-10-15');assert.equal(defaults.to_date,'2026-11-13');assert.equal(defaults.mode,'session');
const cleaned=cleanHistoryQuery({...query,name:'  Nguye\u0302\u0303n QA  ',class_id:'  qa-class  ',student_id:'  stable-qa-id  '});
assert.equal(cleaned.name,'Nguyễn QA');assert.equal(cleaned.class_id,'qa-class');assert.equal(cleaned.student_id,'stable-qa-id');
assert.equal(cleanHistoryQuery({...query,name:' ',class_id:''}).name,undefined);
assert.equal(historyScore(0),'0','zero is a real grade');assert.equal(historyScore(1.25),'1,25');
for(const empty of [null,undefined,NaN,Infinity])assert.equal(historyScore(empty),HISTORY_NO_DATA,'unknown grade is not zero/not-submitted');
assert.equal(historyAttendance(null),HISTORY_NO_DATA,'missing attendance is not absence');assert.equal(historyAttendance('unknown'),HISTORY_NO_DATA);
assert.equal(historyAttendance('vang'),'Vắng');assert.equal(historyAttendance('co_mat'),'Có mặt');assert.equal(historyAttendance('hoc_online'),'Học online');assert.equal(historyAttendance('vang_phep'),'Vắng có phép');
assert.equal(historyAttendanceSource('van_tay'),'Vân tay');assert.equal(historyAttendanceSource(null),'');assert.equal(historyAttendanceSource('unverified'),'');
assert.match(historyEnrollment('former'),/lịch sử.*đã nghỉ/);assert.match(historyEnrollment('transferred'),/lịch sử.*chuyển lớp/);assert.doesNotMatch(historyEnrollment('active'),/hiện|đang học/);
assert.equal(historyDate('2026-02-31'),HISTORY_NO_DATA);assert.equal(historyDate('2026-11-13'),'13/11/2026');
assert.match(historyDateTime('2026-11-13T12:30:00Z'),/19:30/);assert.match(historyDateTime('2026-11-13T12:30:00Z'),/13\/11\/2026/);assert.equal(historyDateTime(null),HISTORY_NO_DATA);
assert.match(historyScoreBasis('previous_assignment_day','session'),/buổi trước/);assert.match(historyScoreBasis('assignment_date','assignment'),/ngày giao/);
const row:StaffHistoryRow={record_id:'qa-record-a',student_id:'qa-student-a',student_name:'Nguyễn QA Trùng',class_id:'qa-class-a',class_name:'Lớp QA A',lesson_date:'2026-11-12',attendance_status:null,enrollment_status:'former',homework:[{assignment_id:'qa-assignment-a',title:'Phiếu QA',score:0,status:'submitted'}]};
const sameNameOther={...row,record_id:'qa-record-b',student_id:'qa-student-b',enrollment_status:'transferred' as const};
assert.notEqual(historyRowKey(row),historyRowKey(sameNameOther),'same name in same class does not merge two student identities');
assert.notEqual(historyRowKey(row),historyRowKey({...row,class_id:'qa-class-b'}),'historical class is part of identity');
assert.notEqual(historyRowKey(row),historyRowKey({...row,lesson_date:'2026-11-11'}),'each previous session remains separate');
assert.equal(historyStudentName({...row,display_name:'Tên hiển thị QA'}),'Tên hiển thị QA');
const page:StaffHistoryPage={ok:true,mode:'session',classes:[{class_id:'qa-class-a',class_name:'Lớp QA A'}],rows:[row,sameNameOther],total:2,page:1,page_size:20,has_more:false,score_basis:'previous_assignment_day'};
assert.strictEqual(validateHistoryPage(page),page);assert.equal(page.rows.length,2,'validation preserves duplicate names, all assignments and historical rows');
for(const patch of [{ok:false},{total:-1},{page:0},{page_size:101},{rows:[{...row,student_id:''}]},{rows:[{...row,record_id:''}]},{rows:[{...row,homework:null}]}])assert.throws(()=>validateHistoryPage({...page,...patch} as StaffHistoryPage));
assert.equal(defaults.work_kind,'homework','old report defaults remain homework');
assert.equal(cleaned.work_kind,'homework','legacy query resolves explicitly to homework');
const examQuery=cleanHistoryQuery({...query,work_kind:'exam',mode:'assignment',student_id:row.student_id,page:3});
assert.equal(examQuery.work_kind,'exam');assert.equal(examQuery.student_id,row.student_id);assert.equal(examQuery.page,3,'kind survives pagination/detail query');
for(const work_kind of ['',null,'all','monthly','is_test'])assert.ok(validateHistoryQuery({...query,work_kind} as any,'2026-11-13'),'invalid kind must not become an unfiltered report');
assert.equal(historyWorkLabel('exam'),'Đề kiểm tra');assert.equal(historyWorkStatus('not_released'),'Chưa công bố kết quả');
assert.equal(historyScoreBasis('assessment_date','session','exam'),'Các bài kiểm tra trong ngày');
assert.equal(historyScoreBasis('assessment_date','assignment','exam'),'Các bài kiểm tra trong ngày','exam scores do not come from the previous homework assignment day');
const examRow:StaffHistoryRow={...row,record_id:'qa-exam-row',homework:[{assignment_id:'qa-exam-a',work_kind:'exam',exam_type:'custom',assessment_id:'55555555-5555-4555-8555-555555555555',title:'Kiểm tra QA',score:null,status:'not_released',submitted_at:'2026-11-12T10:30:00Z'}]};
const examPage:StaffHistoryPage={...page,work_kind:'exam',score_basis:'assessment_date',rows:[examRow],total:1};
assert.strictEqual(validateHistoryPage(examPage,'exam'),examPage);
assert.throws(()=>validateHistoryPage(page,'exam'),'old server ignoring kind filter must not label homework as exams');
assert.throws(()=>validateHistoryPage(examPage),'exam response cannot contaminate homework report');
assert.throws(()=>validateHistoryPage({...examPage,rows:[row]},'exam'),'mixed homework item refused even with an exam page label');
assert.throws(()=>validateHistoryPage({...examPage,rows:[{...examRow,homework:[{...examRow.homework[0],score:10}]}]},'exam'),'unreleased official score must never render');
assert.equal(validateHistoryPage({...examPage,rows:[{...examRow,homework:[{...examRow.homework[0],score:0,status:'submitted'}]}]},'exam').rows[0].homework[0].score,0,'released zero is preserved');
assert.strictEqual(validateHistoryPage({...page,work_kind:'homework'}).rows[0],row,'legacy homework response stays compatible');
console.log('Staff history: bounded filters, Vietnam dates, null vs zero, stable identity, pagination, separate work kind and unreleased-exam guards verified; no cloud.');

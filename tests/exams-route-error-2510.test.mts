import assert from 'node:assert/strict';
import {isChunkFailure,routeFailure,reloadChunkOnce,CHUNK_RELOAD_KEY} from '../src/migration/route-failure';
import {safeClientError,createClientErrorLogger} from '../server/btvn/client-error';
import {cleanHomeworkTitle,homeworkDisplayNote,lessonHomeworkTitle} from '../src/native/homework/presentation';
import {createBtvnApi} from '../api/btvn';
let passed=0;const test=(label:string,run:()=>void)=>{run();passed++;console.log('PASS',label);};
test('null and non-string titles use existing fallback',()=>{for(const raw of [null,undefined,17,{},[]])assert.equal(cleanHomeworkTitle(raw),'');assert.equal(cleanHomeworkTitle('Ôn_tập.pdf'),'Ôn tập');assert.equal(homeworkDisplayNote({title:null,homeworkTitle:null} as any),'');assert.equal(lessonHomeworkTitle({lessonCode:'local',title:null,homeworkTitle:null} as any),'Bài tập về nhà');});
test('recognise browser chunk errors, leave ordinary errors alone',()=>{for(const message of ['Failed to fetch dynamically imported module: https://site/assets/x.js','Importing a module script failed.','error loading dynamically imported module','Loading chunk 12 failed.','Unable to preload CSS for /assets/a.css'])assert.equal(isChunkFailure(new TypeError(message)),true);assert.equal(isChunkFailure({name:'ChunkLoadError'}),true);for(const e of [null,'ChunkLoadError',new TypeError('Cannot read properties of null')])assert.equal(isChunkFailure(e),false);});
test('persistent marker limits reload to once across new executions',()=>{const values=new Map<string,string>(),storage={getItem:(k:string)=>values.get(k)??null,setItem:(k:string,v:string)=>{values.set(k,v);}};let reloads=0;const error={name:'ChunkLoadError'};assert.equal(reloadChunkOnce(error,storage,()=>reloads++),true);assert.equal(reloadChunkOnce(error,storage,()=>reloads++),false);assert.equal(reloads,1);assert.equal(values.get(CHUNK_RELOAD_KEY),'1');});
test('denied storage cannot create a reload loop',()=>{let reloads=0;const denied={getItem:()=>{throw Error('Denied');},setItem:()=>{}};assert.equal(reloadChunkOnce({name:'ChunkLoadError'},denied,()=>reloads++),false);assert.equal(reloads,0);});
test('ordinary render error never reloads',()=>{let touched=false;assert.equal(reloadChunkOnce(new TypeError('bad data'),{getItem:()=>{touched=true;return null;},setItem:()=>{}},()=>{touched=true;}),false);assert.equal(touched,false);});
test('report strips message, query, identity and arbitrary properties',()=>{const e=new TypeError('private student phone=0987654321 PIN=654321');e.stack='TypeError: private student\n at X (https://site/assets/Homework-abc.js:3:17)\n at X (https://site/btvn/private?pin=654321:3:1)\n at X (https://site/src/a.tsx?identity=secret:2:3)';const result=routeFailure(Object.assign(e,{student:'private',answers:{x:'secret'}}));assert.deepEqual(result.frames,['/assets/Homework-abc.js:3:17']);assert.equal(result.name,'TypeError');assert.equal(result.code,'unclassified');assert.doesNotMatch(JSON.stringify(result),/private|0987654321|654321|secret|answers/);});
test('server rebuilds schema, ignores extra message and rejects unsafe frames',()=>{const report=routeFailure(new Error('secret'));assert.deepEqual(safeClientError({...report,message:'secret',student:'private'}),report);for(const frames of [['/assets/x.js?token=secret:1:2'],['/src/../private.ts:1:2'],['https://site/assets/x.js:1:2'],Array(9).fill('/src/a.ts:1:2')])assert.equal(safeClientError({...report,frames}),null);assert.equal(safeClientError({...report,name:'secret'}),null);});
test('server bounds log volume without storing identity',()=>{let at=100000;const entries:any[]=[],log=createClientErrorLogger((...x)=>entries.push(x),()=>at),report=routeFailure(new Error());for(let i=0;i<100;i++)assert.equal(log(report),true);assert.equal(entries.length,30);at+=60000;log(report);assert.equal(entries.length,31);assert.equal(log({}),false);});
const handler=createBtvnApi(()=>({VERCEL_ENV:'production'} as any));
async function api(body:unknown,origin='https://www.minhthanhmath.vn',method='POST'){let status=0,result:unknown;const old=console.error;console.error=()=>{};try{await handler({method,body,headers:{host:'www.minhthanhmath.vn',origin}},{setHeader:()=>{},status:n=>({json:b=>{status=n;result=b;}})});}finally{console.error=old;}return {status,result};}
assert.equal((await api({action:'client-error',error:routeFailure(new Error())})).status,202);passed++;
assert.equal((await api({action:'client-error',error:routeFailure(new Error())},'https://other.example')).status,403);passed++;
assert.equal((await api({action:'client-error',error:{message:'private'}})).status,400);passed++;
assert.equal((await api({action:'classes'})).status,503,'existing env gate retained');passed++;
console.log(`ROUTE_ERROR_TESTS ${passed}/${passed}`);

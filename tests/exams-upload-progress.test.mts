import assert from 'node:assert/strict';
import {overallUploadProgress,uploadProgress} from '../src/native/lesson-upload/upload-progress';
import type {LessonSession,LessonUpload,UploadDashboard,UploadStep} from '../src/native/lesson-upload/model';
const steps=(count:number):UploadStep[]=>Array.from({length:6},(_,i)=>({step:i+1,status:i<count?'xong':'cho',detail:null}));
const base:LessonUpload={id:'qa-upload-a',class_ids:['qa-a'],lesson_date:'2026-11-12',teacher_key:'qa-teacher',title:'Phiếu tổng hợp QA',task_scope:'Câu 1–2',version:1,created_at:'2026-11-12T12:00:00Z',homework_uploaded:true,steps:steps(3)};
assert.deepEqual(uploadProgress(undefined),{processedPercent:0,remainingPercent:100,published:false,issues:[],stage_label:'Chưa gửi bài'});
assert.equal(uploadProgress(base).processedPercent,50);
assert.equal(uploadProgress(base).remainingPercent,50);
assert.equal(uploadProgress(base).published,false);
assert.equal(uploadProgress({...base,steps:steps(6)}).processedPercent,100,'one paper has six slots, not twelve');
assert.equal(uploadProgress({...base,steps:[...steps(3),...steps(3),{step:0,status:'xong',detail:null},{step:7,status:'xong',detail:null},{step:2.5,status:'xong',detail:null}]}).processedPercent,50,'duplicate/invalid slots cannot inflate progress');
const second={...base,homework2_uploaded:true,steps:steps(6),paper2_steps:steps(2)};
assert.equal(uploadProgress(second).processedPercent,67,'eight completed slots out of twelve');
assert.equal(uploadProgress(second).remainingPercent,33);
assert.equal(uploadProgress(second).published,false,'both supplied papers need their publish receipt');
assert.equal(uploadProgress({...second,paper2_steps:steps(6)}).published,true);
assert.equal(uploadProgress({...base,homework2_uploaded:false,paper2_steps:steps(0),steps:steps(6)}).published,true,'unused paper-two slots do not block a one-paper job');
const warning:LessonUpload={...base,steps:[...steps(3),{step:4,status:'canh_bao',detail:'Kiểm chéo đang chờ.'},{step:5,status:'loi',detail:'Tài liệu cần bổ sung.'},{step:6,status:'xong',detail:null}]};
const publishedWarning=uploadProgress(warning);
assert.equal(publishedWarning.published,true,'publish receipt is not undone by post-publication review/material issues');
assert.equal(publishedWarning.processedPercent,67,'processing completeness is separate from publication');
assert.equal(publishedWarning.issues.length,2);
assert.deepEqual(publishedWarning.issues.map(i=>[i.paper,i.step,i.status]),[[1,4,'canh_bao'],[1,5,'loi']]);
assert.match(publishedWarning.stage_label,/Đã giao bài/);
const repeatIssue=uploadProgress({...base,steps:[{step:4,status:'loi',detail:'Đáp án chưa khớp.'},{step:4,status:'loi',detail:'Đáp án chưa khớp.'},{step:9,status:'loi',detail:'Không hợp lệ.'}]});
assert.equal(repeatIssue.issues.length,1);
assert.equal(repeatIssue.published,false);
assert.equal(repeatIssue.stage_label,'Cần kiểm tra');
assert.equal(uploadProgress({...base,steps:[{step:1,status:'xong',detail:null}]}).stage_label,'Đã nhận, chờ AI xử lý');

const session:LessonSession={class_id:'qa-a',class_name:'Lớp QA A',lesson_date:'2026-11-12',teacher_key:'qa-teacher',start_time:'17:00',end_time:'19:00'};
const paired={...session,class_id:'qa-b',class_name:'Lớp QA B',lesson_date:'2026-11-13',start_time:'18:00',end_time:'20:00'};
const missing={...session,class_id:'qa-c',class_name:'Lớp QA C'};
const data:UploadDashboard={staff:{user_id:'qa-owner',short_name:'qa',display_name:'Giáo viên QA',role:'gv',teacher_key:'qa-teacher'},teachers:[],sessions:[session,paired,missing,{...session,class_id:'qa-future',lesson_date:'2026-11-16'}],uploads:[{...warning,class_ids:['qa-a','qa-b'],class_dates:{'qa-a':'2026-11-12','qa-b':'2026-11-13'}}],week_start:'2026-11-09',week_end:'2026-11-15',server_now:'2026-11-13T13:00:00Z'};
let totals=overallUploadProgress(data);
assert.deepEqual(totals,{total:3,publishedCount:2,unpublishedCount:1,publishedPercent:67,unpublishedPercent:33,clockValid:true},'paired dates count each finished authorized class session');
totals=overallUploadProgress({...data,uploads:[...data.uploads,{...base,id:'qa-new',class_ids:['qa-a'],version:2,steps:steps(1)}]});
assert.equal(totals.publishedCount,1,'a newer unfinished version takes precedence over an older published version');
assert.equal(totals.unpublishedCount,2);
assert.equal(overallUploadProgress({...data,sessions:[session,session]}).total,1,'duplicate dashboard row is not a second session');
assert.equal(overallUploadProgress({...data,sessions:[session],uploads:[{...base,class_ids:['qa-foreign'],steps:steps(6)}]}).publishedCount,0,'foreign uploads do not expand authenticated class scope');
assert.deepEqual(overallUploadProgress({...data,sessions:[]}),{total:0,publishedCount:0,unpublishedCount:0,publishedPercent:0,unpublishedPercent:0,clockValid:true});
assert.equal(overallUploadProgress(data,new Date('bad-date')).clockValid,false);
assert.equal(overallUploadProgress(data,new Date('bad-date')).total,0);
assert.equal(overallUploadProgress({...data,sessions:[{...session,lesson_date:'2026-02-31'}]}).total,0,'invalid dates never enter denominator');
assert.equal(overallUploadProgress({...data,sessions:[{...session,end_time:''}]}).total,0,'missing end time is not proof the session ended');
const overnight={...session,start_time:'23:00',end_time:'00:30'};
assert.equal(overallUploadProgress({...data,sessions:[overnight]},new Date('2026-11-12T17:00:00Z')).total,0,'midnight local has not reached the overnight end');
assert.equal(overallUploadProgress({...data,sessions:[overnight]},new Date('2026-11-12T17:30:00Z')).total,1,'overnight session enters denominator exactly at end');
console.log('Upload progress: one/two-paper slot counts, dedupe, publication vs post-review issues, latest authorized finished sessions and midnight boundaries verified.');

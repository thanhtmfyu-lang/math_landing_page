import assert from 'node:assert/strict';
import {completedPercent,latestForSession,nearestSession,normalizedVideoUrl,validateUpload,validVideoUrl,vietnamToday,weekProgress,type LessonSession,type LessonUpload,type UploadDashboard} from '../src/native/lesson-upload/model';
import {jpegPagesPdf,privatePdf} from '../src/native/lesson-upload/files';
const base:LessonSession={class_id:'lop-a',class_name:'2K9 T2',lesson_date:'2026-11-02',teacher_key:'thanh',start_time:'18:00',end_time:'20:00',class_ids:['lop-a','lop-b']};
const paired={...base,class_id:'lop-b',class_name:'2K9 T3',lesson_date:'2026-11-03'};
const steps=Array.from({length:6},(_,i)=>({step:i+1,status:'xong' as const,detail:null}));
const upload:LessonUpload={id:'ban-cu',class_ids:['lop-a','lop-b'],class_dates:{'lop-a':'2026-11-02','lop-b':'2026-11-03'},lesson_date:'2026-11-02',teacher_key:'thanh',title:'Cuc tri',task_scope:'Cau 1-10',version:1,created_at:'2026-11-02T11:00:00Z',has_homework:true,has_answer:true,has_handout:true,has_video:true,steps};
assert.equal(completedPercent(steps),100);
assert.equal(completedPercent([...steps,steps[0],{step:9,status:'xong',detail:null}]),100,'duplicate/out-of-range steps must not inflate progress');
assert.equal(completedPercent([{step:1,status:'xong',detail:null},{step:2,status:'dang',detail:null},{step:3,status:'loi',detail:null}]),17);
assert.equal(latestForSession([upload],paired)?.id,'ban-cu','paired groups resolve their own real schedule dates');
assert.equal(latestForSession([upload],{...paired,lesson_date:'2026-11-02'}),undefined,'paired second class must not receive wrong-day history');
assert.equal(latestForSession([{...upload,teacher_key:'tai'}],base),undefined,'another teacher history does not match');
const revision={...upload,id:'ban-moi',version:2,has_answer:false,has_video:false,steps:[{step:1,status:'xong' as const,detail:null}]};
const dashboard:UploadDashboard={staff:{user_id:'a',short_name:'thanh',display_name:'Thay Thanh',teacher_key:'thanh',role:'gv'},teachers:[],week_start:'2026-11-02',week_end:'2026-11-08',sessions:[base,paired,{...base,class_id:'lop-c',lesson_date:'2026-11-07'}],uploads:[upload,revision],server_now:'2026-11-03T14:00:00Z'};
const progress=weekProgress(dashboard);
assert.equal(progress.total,2,'only completed scheduled sessions count');
assert.equal(progress.bars.find(b=>b.kind==='homework')?.percent,50);
assert.equal(progress.bars.find(b=>b.kind==='answer')?.percent,0,'new version replaces old asset state');
assert.equal(progress.bars.find(b=>b.kind==='ai')?.percent,0,'receiving files is not AI completion');
assert.equal(weekProgress({...dashboard,sessions:[]}).bars[0].percent,0,'zero denominator stays finite');
assert.equal(nearestSession([base,paired],'2026-11-03')?.class_id,'lop-b');
assert.equal(vietnamToday(new Date('2026-11-01T18:00:00Z')),'2026-11-02');
assert.ok(validVideoUrl('https://youtu.be/abcdefghijk'));
assert.ok(validVideoUrl('https://www.youtube.com/watch?v=abcdefghijk'));
assert.ok(validVideoUrl('https://mtm.zoom.us/rec/share/example'));
assert.equal(normalizedVideoUrl('https://m.youtube.com/watch?feature=shared&v=abcdefghijk'),'https://www.youtube.com/watch?v=abcdefghijk','accepted YouTube links use the same canonical format as RPC validation');
for(const bad of ['http://youtu.be/abcdefghijk','https://youtu.be.evil.test/abcdefghijk','https://evil.test/?url=youtube.com','https://user:secret@zoom.us/rec/play/abc','https://zoom.us/j/123','javascript:alert(1)','https://zoom.us:444/rec/play/abc'])assert.equal(validVideoUrl(bad),false,bad);
const valid={title:'Bai hoc',scope:'Cau 1-10',homework:true,answer:false,handout:false,video:''};
assert.equal(validateUpload(valid),null);
assert.ok(validateUpload({...valid,scope:''}));
assert.ok(validateUpload({...valid,scope:'x'.repeat(301)}));
assert.ok(validateUpload({...valid,homework:false}));
assert.equal(validateUpload({...valid,homework:false,answer:true}),'Gửi đáp án cùng đề BTVN để AI đối chiếu đúng phiên bản.');
assert.equal(validateUpload({...valid,answer:true}),null,'answer plus homework is a complete source version');
assert.equal(validateUpload({...valid,homework:false,handout:true}),null,'handout-only remains supported');
assert.equal(validateUpload({...valid,homework:false,video:'https://youtu.be/abcdefghijk'}),null,'video-only remains supported');
await assert.rejects(privatePdf([],true));
await assert.rejects(privatePdf([new File(['fake'],'fake.pdf',{type:'application/pdf'})],false));
const original=new File(['%PDF-1.4\nfixture'],'teacher.pdf',{type:'application/pdf'});
const result=await privatePdf([original],false);assert.equal(result.size,original.size);assert.equal(result.type,'application/pdf');
const pdf=jpegPagesPdf([{bytes:new Uint8Array([255,216,255,217]),width:700,height:1000},{bytes:new Uint8Array([255,216,255,217]),width:1400,height:800}]);
const bytes=new Uint8Array(await pdf.arrayBuffer()),text=new TextDecoder().decode(bytes);
assert.match(text,/\/Count 2/);assert.match(text,/\/MediaBox \[0 0 595 842\]/);assert.match(text,/\/MediaBox \[0 0 842 595\]/);
const xref=Number(/startxref\n(\d+)/.exec(text)![1]);assert.equal(new TextDecoder().decode(bytes.slice(xref,xref+4)),'xref');
const entries=text.slice(text.indexOf('xref\n')).split('\n').slice(3,11);entries.forEach((line,i)=>{const offset=Number(line.slice(0,10));assert.equal(new TextDecoder().decode(bytes.slice(offset,offset+7)).startsWith(`${i+1} 0 obj`),true,`valid byte offset object ${i+1}`);});
console.log('Lesson upload: paired dates, current-version progress, validation, private PDF and PDF byte offsets verified.');

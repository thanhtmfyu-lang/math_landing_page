import assert from 'node:assert/strict';
import * as React from 'react';
import {renderToStaticMarkup} from 'react-dom/server';
import {buildClassOverview} from '../server/btvn/class-overview';
import {SCHEDULE_SNAPSHOT} from '../server/schedule/lich-lop';
import MyClass from '../src/native/homework/MyClass';
import type {HomeworkLesson,HomeworkState} from '../src/native/homework/btvn-contract';
(globalThis as any).React=React;
const now=Date.parse('2026-10-21T12:00:00+07:00');
const make=(code:string,extra:Partial<HomeworkLesson>={}):HomeworkLesson=>({lessonCode:code,classNames:['2K9 9+'],date:'2026-10-20',title:code,videoId:null,materialUrl:null,handoutUrl:null,homeworkUrl:null,dueAt:null,bestScore:null,late:null,submittedAt:null,available:true,...extra});
const lessons=[make('own-open',{submittedAt:now-1000,videoId:'fixture-video'}),make('other-class-secret',{classNames:['2K9 8+']}),make('future-private',{locked:true,handoutUrl:'private-fixture'}),make('own-monthly',{kind:'kiem-tra-thang'})];
const result=buildClassOverview({className:'2K9 9+',lessons},{rows:SCHEDULE_SNAPSHOT,source:'snapshot',snapshotDate:'2026-10-20'},now);
assert.deepEqual(result.open.map(c=>c.lessonCode),['own-open']);
assert.deepEqual(result.monthly.map(c=>c.lessonCode),['own-monthly']);
assert.equal(result.latest?.lessonCode,'own-open');
assert.deepEqual(result.progress,{submitted:1,opened:1});
assert.equal(result.week.length,3);
assert.equal(result.next?.startsAt,Date.parse('2026-10-21T17:30:00+07:00'));
assert.doesNotMatch(JSON.stringify(result),/other-class-secret|future-private|private-fixture|fixture-video/);
const state={className:'2K9 9+',classOverview:result} as HomeworkState;
const html=renderToStaticMarkup(React.createElement(MyClass,{state,onSelect:()=>{},busy:false}));
assert.match(html,/Lớp của em/);
assert.match(html,/own-open/);
assert.match(html,/Lịch dự phòng/);
assert.match(html,/Ghi nhận trong lộ trình ngày/);
assert.doesNotMatch(html,/other-class-secret|future-private/);
const stale=renderToStaticMarkup(React.createElement(MyClass,{state:{...state,className:'2K9 8+'},onSelect:()=>{},busy:false}));
assert.equal(stale,'');
const friday=buildClassOverview({className:'2K10 9+',lessons:[]},{rows:SCHEDULE_SNAPSHOT,source:'snapshot'},now);
assert.equal(friday.week.some(s=>new Date(s.startsAt+7*3600000).getUTCDay()===5),false,'Attendance fallback must not become a weekly meeting');
console.log('My Class projects only authenticated class data; locked resources and stale class response never render.');

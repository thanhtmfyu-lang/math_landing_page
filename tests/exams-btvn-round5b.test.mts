import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {readFileSync,mkdirSync,writeFileSync} from 'node:fs';
import {pathToFileURL} from 'node:url';
const root=process.env.MTM_ROOT??process.cwd();
const require=createRequire(root+'/package.json');
const {build}=require('esbuild');
const out=root+'/.qa-temp/round5b';mkdirSync(out,{recursive:true});
// Render và gọi handler của component thật, chỉ dùng thông tin tổng hợp.
const entry=`import React from 'react';import {renderToStaticMarkup} from 'react-dom/server';import assert from 'node:assert/strict';import GateComponent from './src/native/homework/HomeworkGate';import {mount} from './tests/daily19-ui-harness.mts';
const HomeworkGate=props=>mount('src/native/homework/HomeworkGate.tsx',props).tree;
const calls=[],identity={fullName:'Học sinh giả',phone:'0900000000',className:'Lớp giả'};
const props={studentCode:'FAKE-CODE',identity,classNames:[identity.className],busy:false,onCode:()=>{},onIdentity:()=>{},onLogin:input=>calls.push(input)};
const walk=node=>Array.isArray(node)?node.flatMap(walk):React.isValidElement(node)?[node,...walk(node.props.children)]:[];
const formsOf=tree=>walk(tree).filter(node=>node.type==='form');
const forms=formsOf(HomeworkGate(props));
assert.equal(forms.length,2);assert.equal(forms[0].type,'form');assert.equal(forms[1].type,'form');
const submit=form=>{let prevented=false;form.props.onSubmit({preventDefault(){prevented=true}});assert.ok(prevented);};
submit(forms[0]);submit(forms[1]);assert.deepEqual(calls,[{studentCode:'FAKE-CODE'},identity]);
submit(formsOf(HomeworkGate({...props,identity:{fullName:'',phone:'',className:''}}))[0]);
submit(formsOf(HomeworkGate({...props,studentCode:''}))[1]);
assert.deepEqual(calls.slice(2),[{studentCode:'FAKE-CODE'},identity]);
const disabled=HomeworkGate({...props,busy:true});formsOf(disabled).forEach(submit);assert.equal(calls.length,4);
for(const form of formsOf(disabled))assert.ok(walk(form).find(n=>n.type==='button').props.disabled);
const inputs=forms.map(f=>walk(f).filter(n=>(n.type==='input'&&n.props.type!=='checkbox')||n.type==='select'));assert.deepEqual(inputs.map(i=>i.length),[1,3]);assert.ok(inputs.flat().every(i=>i.props.required));
let changed;const editing=HomeworkGate({...props,onCode:value=>changed=value,onIdentity:value=>changed=value});
walk(formsOf(editing)[0]).find(n=>n.type==='input').props.onChange({target:{value:'NEW-CODE'}});assert.equal(changed,'NEW-CODE');
walk(formsOf(editing)[1]).filter(n=>n.type==='input')[1].props.onChange({target:{value:'0900000001'}});assert.deepEqual(changed,{...identity,phone:'0900000001'});
export const html=renderToStaticMarkup(<GateComponent {...props}/>);
assert.ok(html.indexOf('id="btvn-code-title"')<html.indexOf('id="btvn-identity-title"'));assert.ok(!html.includes('Quên mã'));assert.equal((html.match(/type="submit"/g)||[]).length,2);
`;
const bundle=await build({stdin:{contents:entry,resolveDir:root,loader:'tsx'},bundle:true,write:false,platform:'node',format:'cjs',jsx:'automatic',packages:'external'});
writeFileSync(out+'/gate.cjs',bundle.outputFiles[0].text);
const rendered=(await import(pathToFileURL(out+'/gate.cjs').href)).default;
const session=readFileSync(root+'/src/native/homework/HomeworkSession.tsx','utf8');
assert.ok(session.includes("onLogin={(input,remember)=>void run('login',input,remember)}"));
assert.ok(!session.includes('setMode'));assert.ok(!session.includes('Quên mã'));
assert.ok(session.includes("entryFailure(response.status,data.message)"));
const css=readFileSync(root+'/src/native/homework/btvn-session.css','utf8');
assert.ok(css.includes('grid-template-columns:repeat(2,minmax(0,1fr))'));
assert.match(css,/\.btvn-gates\{[^}]*align-items:start(?:;|\})/,'Hai thẻ cao theo nội dung, không kéo thẻ Có mã tạo khoảng trống');
assert.ok(css.includes('@media(max-width:700px){.btvn-gates{grid-template-columns:minmax(0,1fr)'));
writeFileSync(out+'/render.html','<!doctype html><html lang="vi"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>*{box-sizing:border-box}'+css+'</style><section class="btvn-session">'+rendered.html+'</section></html>');
console.log('Đạt hai form thật, payload riêng khi thẻ kia trống, chặn busy, sửa ô nhập, lỗi chung; CSS desktop/mobile kiểm tĩnh. Chưa kiểm pixel/validation browser.');

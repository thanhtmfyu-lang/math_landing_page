assert.match(html,/Chưa công bố kết quả/);assert.match(html,/Điểm bài kiểm tra chỉ hiển thị sau giờ đóng bài/);
assert.match(html,/data-label="Đề kiểm tra"/);assert.match(html,/Ngày kiểm tra:/);

html=render({...page,work_kind:'homework',rows:[{...row,homework:[{assignment_id:'synthetic-hw',title:'Phiếu BTVN tổng hợp QA',score:0,status:'submitted'}]}],score_basis:'previous_assignment_day'},'homework');
